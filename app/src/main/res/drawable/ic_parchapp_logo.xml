<?xml version="1.0" encoding="utf-8"?>
<!-- logo inside the white card used on welcome and sign in -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="10dp" android:right="10dp" android:top="8dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#E2E8F0" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_parchapp_mark"
        android:left="16dp"
        android:right="16dp"
        android:top="14dp"
        android:bottom="14dp" />
</layer-list>
