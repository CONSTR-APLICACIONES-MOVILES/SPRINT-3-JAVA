<?xml version="1.0" encoding="utf-8"?>
<!-- chat bubble of another person: white, the corner next to the avatar is sharp -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@android:color/white" />
    <corners android:bottomLeftRadius="4dp" android:bottomRightRadius="18dp" android:topLeftRadius="18dp" android:topRightRadius="18dp" />
    <stroke android:width="1dp" android:color="@color/brand_card_stroke" />
</shape>
