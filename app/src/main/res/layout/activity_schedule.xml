<?xml version="1.0" encoding="utf-8"?>
<!-- Schedule, the same layout as the Flutter ScheduleView: friend bar, Google Calendar card, duration, week, two lanes and the floating common slots banner -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:orientation="vertical">

    <include layout="@layout/view_top_header" />

    <!-- Friend bar: Me, the compared friends, Add friends and Comparing (N) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/schedule_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/schedule_compare_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_sch_comparing_off"
            android:drawableStart="@drawable/ic_compare_arrows"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Google Calendar import -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sch_card"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_sch_icon_box"
                android:contentDescription="@null"
                android:padding="7dp"
                android:src="@drawable/ic_calendar"
                android:tint="@color/brand_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/schedule_calendar_title"
                    android:textColor="#111827"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/schedule_import_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/schedule_import_idle"
                    android:textColor="#64748B"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/schedule_import_btn"
                android:layout_width="105dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_sch_import_btn"
                android:drawableStart="@drawable/ic_download"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/schedule_import"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Duration: quick chips and an hours:minutes stepper -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_timer"
            android:tint="@color/brand_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="@string/duration_label"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/schedule_durations"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <!-- custom duration: hours : minutes, each with < and > -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_sch_stepper"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="5dp">

                    <ImageView android:id="@+id/schedule_hours_down" android:layout_width="24dp" android:layout_height="24dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/schedule_less_hours" android:padding="3dp" android:src="@drawable/ic_chevron_left" android:tint="@color/brand_primary" />
                    <EditText android:id="@+id/schedule_hours" android:layout_width="32dp" android:layout_height="30dp" android:background="@null" android:gravity="center" android:imeOptions="actionDone" android:importantForAutofill="no" android:inputType="number" android:maxLength="2" android:padding="0dp" android:textColor="#111827" android:textSize="13sp" android:textStyle="bold" android:hint="0" />
                    <ImageView android:id="@+id/schedule_hours_up" android:layout_width="24dp" android:layout_height="24dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/schedule_more_hours" android:padding="3dp" android:src="@drawable/ic_chevron_right" android:tint="@color/brand_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="5dp" android:paddingEnd="5dp" android:text=":" android:textColor="#111827" android:textSize="15sp" android:textStyle="bold" />
                    <ImageView android:id="@+id/schedule_minutes_down" android:layout_width="24dp" android:layout_height="24dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/schedule_less_minutes" android:padding="3dp" android:src="@drawable/ic_chevron_left" android:tint="@color/brand_primary" />
                    <EditText android:id="@+id/schedule_minutes" android:layout_width="32dp" android:layout_height="30dp" android:background="@null" android:gravity="center" android:imeOptions="actionDone" android:importantForAutofill="no" android:inputType="number" android:maxLength="2" android:padding="0dp" android:textColor="#111827" android:textSize="13sp" android:textStyle="bold" android:hint="00" />
                    <ImageView android:id="@+id/schedule_minutes_up" android:layout_width="24dp" android:layout_height="24dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/schedule_more_minutes" android:padding="3dp" android:src="@drawable/ic_chevron_right" android:tint="@color/brand_primary" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Week: previous / SELECTED WEEK / next / calendar, then Monday to Friday -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="9dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView android:id="@+id/schedule_prev_week" android:layout_width="36dp" android:layout_height="36dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/schedule_previous_week" android:padding="6dp" android:src="@drawable/ic_chevron_left" android:tint="#111827" />

            <LinearLayout
                android:id="@+id/schedule_week_picker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.08" android:text="@string/schedule_selected_week" android:textColor="#64748B" android:textSize="8sp" android:textStyle="bold" />
                <TextView android:id="@+id/schedule_week_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#111827" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <ImageView android:id="@+id/schedule_next_week" android:layout_width="36dp" android:layout_height="36dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/schedule_next_week" android:padding="6dp" android:src="@drawable/ic_chevron_right" android:tint="#111827" />

            <ImageView android:id="@+id/schedule_calendar_btn" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="2dp" android:background="@drawable/bg_sch_icon_box" android:contentDescription="@string/schedule_choose_date" android:padding="8dp" android:src="@drawable/ic_calendar" android:tint="@color/brand_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/schedule_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/schedule_loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/brand_primary"
        app:trackThickness="2dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Lanes and timeline -->
        <LinearLayout
            android:id="@+id/schedule_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F0F4FC">

                <TextView android:layout_width="62dp" android:layout_height="match_parent" android:background="#F0F4FC" android:gravity="center" android:paddingTop="9dp" android:paddingBottom="9dp" android:text="@string/time_column" android:textColor="#64748B" android:textSize="9sp" android:textStyle="bold" />
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#DCE3EF" />

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingTop="9dp" android:paddingEnd="8dp" android:paddingBottom="9dp">
                    <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_sch_avatar_primary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/schedule_my_schedule" android:textColor="@color/brand_primary" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#F8FAFD" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
                    <ImageView android:layout_width="15dp" android:layout_height="15dp" android:contentDescription="@null" android:src="@drawable/ic_group" android:tint="#64748B" />
                    <TextView android:id="@+id/schedule_friends_header" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="@string/schedule_friends" android:textColor="#64748B" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Java team: warns when a compared calendar is not synced (unknown is not counted as free) -->
            <TextView
                android:id="@+id/schedule_state_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFF7E6"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:textColor="#92400E"
                android:textSize="11sp"
                android:visibility="gone" />

            <ScrollView
                android:id="@+id/schedule_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="96dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        android:id="@+id/schedule_time_column"
                        android:layout_width="62dp"
                        android:layout_height="wrap_content"
                        android:background="@android:color/white" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout
                            android:id="@+id/schedule_lanes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E2E8F0" />
                            <FrameLayout android:id="@+id/schedule_lane_me" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/white" />
                            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E2E8F0" />
                            <FrameLayout android:id="@+id/schedule_lane_friends" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#FAFBFD" />
                        </LinearLayout>

                        <!-- hour lines, the selected common slot over both lanes and the now line -->
                        <FrameLayout
                            android:id="@+id/schedule_slot_layer"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </FrameLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- Error state with Retry -->
        <LinearLayout
            android:id="@+id/schedule_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView android:layout_width="50dp" android:layout_height="50dp" android:contentDescription="@null" android:src="@drawable/ic_calendar" android:tint="#64748B" />
            <TextView android:id="@+id/schedule_error_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:textColor="#64748B" android:textSize="14sp" />
            <TextView android:id="@+id/schedule_retry" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginTop="12dp" android:background="@drawable/bg_sch_primary_btn" android:gravity="center" android:paddingStart="24dp" android:paddingEnd="24dp" android:text="@string/schedule_retry" android:textColor="@android:color/white" android:textStyle="bold" />
        </LinearLayout>

        <!-- Plan activity -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/schedule_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="88dp"
            android:contentDescription="@string/schedule_plan_activity"
            android:src="@drawable/ic_add"
            app:backgroundTint="@color/brand_primary"
            app:tint="@android:color/white" />

        <!-- Floating common slots banner, opens the slots sheet -->
        <LinearLayout
            android:id="@+id/schedule_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="12dp"
            android:background="@drawable/bg_sch_banner_empty"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:padding="12dp">

            <ImageView
                android:id="@+id/schedule_summary_icon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_sch_banner_icon_empty"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_event_busy"
                android:tint="#64748B" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView android:id="@+id/schedule_summary_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/schedule_no_common_slots" android:textColor="#111827" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/schedule_summary_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:text="@string/schedule_try_other" android:textColor="#64748B" android:textSize="10.5sp" />
            </LinearLayout>

            <ImageView android:id="@+id/schedule_summary_expand" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_expand_less" android:tint="#64748B" android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
