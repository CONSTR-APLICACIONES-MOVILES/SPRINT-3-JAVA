<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/brand_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_home_indicator" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_icon_badge" android:gravity="center" android:text="▣" android:textColor="@color/brand_primary" android:textSize="16sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/calendar_and_sync" android:textColor="@color/brand_dark" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/calendar_period" android:textColor="@color/brand_slate" android:textSize="11sp" />
            </LinearLayout>
            <ImageButton android:id="@+id/sheet_close_btn" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_icon_badge_square" android:backgroundTint="#F1F5F9" android:contentDescription="@string/close" android:padding="8dp" android:src="@drawable/ic_close" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@color/brand_divider" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/calendar_week" android:textAllCaps="true" android:textColor="@color/brand_dark" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_green_chip" android:paddingStart="8dp" android:paddingTop="4dp" android:paddingEnd="8dp" android:paddingBottom="4dp" android:text="@string/calendar_today_badge" android:textColor="@color/brand_success_dark" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/calendar_event_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
            <View android:layout_width="4dp" android:layout_height="match_parent" android:background="@color/brand_success" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_dashboard_card" android:orientation="vertical" android:padding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:id="@+id/calendar_time_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_green_chip" android:paddingStart="8dp" android:paddingTop="4dp" android:paddingEnd="8dp" android:paddingBottom="4dp" android:textColor="@color/brand_success_dark" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Study Group" android:textColor="@color/brand_slate" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/calendar_title_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/brand_dark" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/calendar_location_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/brand_slate" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/calendar_availability_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_dashed_blue" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
            <TextView android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_icon_badge" android:gravity="center" android:text="◷" android:textColor="@color/brand_primary" android:textSize="14sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/free_availability_block" android:textColor="@color/brand_dark" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/calendar_free_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/brand_slate" android:textSize="10sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_green_chip" android:paddingStart="6dp" android:paddingTop="3dp" android:paddingEnd="6dp" android:paddingBottom="3dp" android:text="@string/synced_free" android:textAllCaps="true" android:textColor="@color/brand_success_dark" android:textSize="9sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
