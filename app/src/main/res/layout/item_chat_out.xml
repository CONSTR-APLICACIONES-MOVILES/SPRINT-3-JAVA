<?xml version="1.0" encoding="utf-8"?>
<!-- my message: bubble on the right, time and a clock while pending or a check once on the server -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="56dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">
    <TextView android:id="@+id/chat_out_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_chat_out" android:paddingStart="14dp" android:paddingTop="9dp" android:paddingEnd="14dp" android:paddingBottom="9dp" android:textColor="@android:color/white" android:textSize="14sp" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:layout_marginEnd="4dp" android:gravity="center_vertical">
        <TextView android:id="@+id/chat_out_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/brand_slate" android:textSize="10sp" />
        <ImageView android:id="@+id/chat_out_state" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="3dp" android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
