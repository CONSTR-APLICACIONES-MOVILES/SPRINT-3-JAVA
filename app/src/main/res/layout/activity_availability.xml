<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F8F9FF" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="12dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="▣  Set Availability Status" android:textColor="@color/brand_dark" android:textSize="19sp" android:textStyle="bold" /><androidx.appcompat.widget.AppCompatButton android:id="@+id/close_availability_button" android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_light_blue" android:text="×" android:textColor="@color/brand_slate" android:textSize="20sp" /></LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Visible to your campus friends and study groups" android:textColor="@color/brand_slate" android:textSize="12sp" />
        <RadioGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
            <RadioButton android:id="@+id/status_available" android:layout_width="match_parent" android:layout_height="62dp" android:background="@drawable/bg_dashboard_card" android:buttonTint="@color/brand_primary" android:padding="12dp" android:text="Available now\nReady to study, grab coffee, or make plans" android:textColor="@color/brand_dark" android:textSize="13sp" />
            <RadioButton android:id="@+id/status_class" android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="8dp" android:background="@drawable/bg_dashboard_card" android:buttonTint="@color/brand_primary" android:padding="12dp" android:text="In Class\nCurrently in lecture or university session" android:textColor="@color/brand_dark" android:textSize="13sp" />
            <RadioButton android:id="@+id/status_focus" android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="8dp" android:background="@drawable/bg_dashboard_card" android:buttonTint="@color/brand_primary" android:padding="12dp" android:text="Deep Focus\nLibrary mode or intense study, do not disturb" android:textColor="@color/brand_dark" android:textSize="13sp" />
            <RadioButton android:id="@+id/status_busy" android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="8dp" android:background="@drawable/bg_dashboard_card" android:buttonTint="@color/brand_primary" android:padding="12dp" android:text="Busy / Personal\nPersonal commitments or work off campus" android:textColor="@color/brand_dark" android:textSize="13sp" />
            <RadioButton android:id="@+id/status_transit" android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="8dp" android:background="@drawable/bg_light_blue" android:buttonTint="@color/brand_primary" android:checked="true" android:padding="12dp" android:text="Commute / In Transit\nOn public transit or walking..." android:textColor="@color/brand_dark" android:textSize="13sp" />
        </RadioGroup>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="STATUS DURATION" android:textColor="@color/brand_slate" android:textSize="10sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><androidx.appcompat.widget.AppCompatButton android:id="@+id/duration_one_hour" android:layout_width="0dp" android:layout_height="38dp" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@drawable/bg_primary_pill" android:text="For 1 hour" android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="10sp" /><androidx.appcompat.widget.AppCompatButton android:id="@+id/duration_until_six" android:layout_width="0dp" android:layout_height="38dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/bg_light_blue" android:text="Until 6:00 PM" android:textAllCaps="false" android:textColor="@color/brand_primary" android:textSize="10sp" /></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"><androidx.appcompat.widget.AppCompatButton android:id="@+id/duration_tomorrow" android:layout_width="0dp" android:layout_height="38dp" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@drawable/bg_light_blue" android:text="Until tomorrow" android:textAllCaps="false" android:textColor="@color/brand_primary" android:textSize="10sp" /><androidx.appcompat.widget.AppCompatButton android:id="@+id/duration_manual" android:layout_width="0dp" android:layout_height="38dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@drawable/bg_light_blue" android:text="Indefinite / Manual" android:textAllCaps="false" android:textColor="@color/brand_primary" android:textSize="10sp" /></LinearLayout></LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_light_blue" android:gravity="center_vertical" android:padding="12dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Automatic synchronization\nSwitch based on your institutional class schedule" android:textColor="@color/brand_dark" android:textSize="11sp" /><androidx.appcompat.widget.AppCompatButton android:layout_width="52dp" android:layout_height="30dp" android:background="@drawable/bg_primary_pill" android:text="ON" android:textColor="@android:color/white" android:textSize="9sp" /></LinearLayout>
    </LinearLayout></ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="78dp" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp"><androidx.appcompat.widget.AppCompatButton android:id="@+id/save_status_button" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_primary_pill" android:text="⚡  Update Status" android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="13sp" android:textStyle="bold" /></LinearLayout>
</LinearLayout>
