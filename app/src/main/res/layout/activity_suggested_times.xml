<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <ImageButton
            android:id="@+id/suggested_times_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_google_button"
            android:contentDescription="Back"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/brand_primary" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Suggested Times"
            android:textColor="@color/brand_dark"
            android:textSize="17sp"
            android:textStyle="bold" />
        <View android:layout_width="38dp" android:layout_height="38dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/suggested_times_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Suggestions use today's schedules in Bogotá. Order and reasons come from the server and respect calendar privacy. Missing availability is never assumed."
                android:textColor="@color/brand_slate"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/suggested_times_activity_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/brand_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/suggested_times_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/brand_slate"
                android:textSize="12sp"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/suggested_times_retry_activity"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_light_blue"
                android:text="Retry activity"
                android:textAllCaps="false"
                android:textColor="@color/brand_primary"
                android:textSize="11sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/suggested_times_loading"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/suggested_times_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_dashboard_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_icon_badge_square"
                        android:backgroundTint="@color/brand_purple_background"
                        android:gravity="center"
                        android:text="✦"
                        android:textColor="@color/brand_purple"
                        android:textSize="16sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Recommended times"
                        android:textColor="@color/brand_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Find times for today in Bogotá using the group's availability and preferences."
                    android:textColor="@color/brand_slate"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/suggested_duration_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <EditText
                        android:id="@+id/suggested_duration_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Duration in minutes (15–720)"
                        android:inputType="number"
                        android:maxLength="3"
                        android:singleLine="true"
                        android:textColor="@color/brand_dark"
                        android:textColorHint="@color/brand_slate"
                        android:textSize="14sp" />
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/suggested_find_times"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_primary_pill"
                        android:text="Find times for today"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/suggested_date_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/brand_slate"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/suggested_filter_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <TextView android:id="@+id/suggested_filter_all" android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="All times" android:textSize="11sp" />
                    <TextView android:id="@+id/suggested_filter_morning" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="Before noon" android:textSize="11sp" />
                    <TextView android:id="@+id/suggested_filter_afternoon" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="6dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="Afternoon/evening" android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/suggested_no_slots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No recommended times are available today."
                    android:textColor="@color/brand_slate"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/suggested_no_matching_times"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No slots match this time filter."
                    android:textColor="@color/brand_slate"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/suggested_slots_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/suggested_feedback_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/brand_urgent_dark"
                    android:textSize="12sp"
                    android:visibility="gone" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/suggested_retry_feedback"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_light_blue"
                    android:text="Retry feedback"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_primary"
                    android:textSize="11sp"
                    android:visibility="gone" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/suggested_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_light_blue"
                    android:text="Refresh recommendations"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_primary"
                    android:textSize="11sp"
                    android:visibility="gone" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/suggested_change_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@android:color/transparent"
                    android:text="Change duration"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_primary"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
