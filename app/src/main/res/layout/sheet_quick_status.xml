<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_home_indicator" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_badge"
                android:gravity="center"
                android:text="◷"
                android:textColor="@color/brand_primary"
                android:textSize="16sp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/update_availability_title"
                    android:textColor="@color/brand_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/update_availability_subtitle"
                    android:textColor="@color/brand_slate"
                    android:textSize="11sp" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/sheet_close_btn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_icon_badge_square"
                android:backgroundTint="#F1F5F9"
                android:contentDescription="@string/close"
                android:padding="8dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/free_until_field"
            android:textAllCaps="true"
            android:textColor="@color/brand_dark"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/free_until_chip_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/chip_time_3" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/bg_chip_unselected" android:gravity="center" android:text="3:00 PM" android:textColor="@color/brand_dark" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/chip_time_4" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/bg_chip_selected" android:gravity="center" android:text="4:00 PM" android:textColor="@color/brand_primary" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/chip_time_5" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/bg_chip_unselected" android:gravity="center" android:text="5:00 PM" android:textColor="@color/brand_dark" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/chip_time_6" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/bg_chip_unselected" android:gravity="center" android:text="6:00 PM" android:textColor="@color/brand_dark" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/input_free_until"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_login_field"
            android:hint="@string/custom_time_hint"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="4:00 PM"
            android:textColor="@color/brand_dark"
            android:textColorHint="@color/brand_slate"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/next_activity_field"
            android:textAllCaps="true"
            android:textColor="@color/brand_dark"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/activity_chip_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/chip_activity_library" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/bg_chip_selected" android:gravity="center" android:text="Library Study" android:textColor="@color/brand_primary" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/chip_activity_linear" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/bg_chip_unselected" android:gravity="center" android:text="Custom activity" android:textColor="@color/brand_dark" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/chip_activity_gym" android:layout_width="0dp" android:layout_height="36dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/bg_chip_unselected" android:gravity="center" android:text="Gym Workout" android:textColor="@color/brand_dark" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/input_next_activity"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_login_field"
            android:hint="@string/custom_activity_hint"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Library Study"
            android:textColor="@color/brand_dark"
            android:textColorHint="@color/brand_slate"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_cancel_status"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_light_blue"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/brand_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save_status"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="2"
                android:background="@drawable/bg_primary_pill"
                android:text="✓  Save Changes"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
