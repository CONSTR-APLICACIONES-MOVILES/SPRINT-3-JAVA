<?xml version="1.0" encoding="utf-8"?>
<!-- a message of another person: avatar, name, bubble and time -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="bottom"
    android:paddingTop="5dp"
    android:paddingEnd="56dp"
    android:paddingBottom="5dp">
    <TextView
        android:id="@+id/chat_in_initials"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_oval_solid"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="vertical">
        <TextView android:id="@+id/chat_in_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginBottom="3dp" android:textColor="@color/brand_dark" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/chat_in_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_chat_in" android:paddingStart="14dp" android:paddingTop="9dp" android:paddingEnd="14dp" android:paddingBottom="9dp" android:textColor="@color/brand_dark" android:textSize="14sp" />
        <TextView android:id="@+id/chat_in_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginTop="3dp" android:textColor="@color/brand_slate" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
