<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_reminder_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_dashboard_card"
    android:orientation="vertical"
    android:padding="13dp">

    <TextView
        android:id="@+id/reminder_activity_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/brand_dark"
        android:textSize="13sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/reminder_activity_schedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/brand_slate"
        android:textSize="11sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/reminder_setting_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/brand_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/reminder_setting_button"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_light_blue"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/reminder_settings_change"
            android:textAllCaps="false"
            android:textColor="@color/brand_primary"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>
    <TextView
        android:id="@+id/reminder_state_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="@color/brand_slate"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
