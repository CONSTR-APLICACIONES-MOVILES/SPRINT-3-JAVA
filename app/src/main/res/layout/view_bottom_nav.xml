<?xml version="1.0" encoding="utf-8"?>
<!-- bottom bar shared by every main screen, BottomNav.setup marks the active tab and opens the screens -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_nav"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@android:color/white"
    android:gravity="center"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/nav_home_icon"
            android:layout_width="56dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:src="@drawable/ic_home"
            android:tint="@color/brand_slate" />
        <TextView
            android:id="@+id/nav_home_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_home"
            android:textColor="@color/brand_slate"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_groups"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/nav_groups_icon"
            android:layout_width="56dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:src="@drawable/ic_group"
            android:tint="@color/brand_slate" />
        <TextView
            android:id="@+id/nav_groups_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_groups"
            android:textColor="@color/brand_slate"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_schedule"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/nav_schedule_icon"
            android:layout_width="56dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:src="@drawable/ic_calendar"
            android:tint="@color/brand_slate" />
        <TextView
            android:id="@+id/nav_schedule_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_schedule"
            android:textColor="@color/brand_slate"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
