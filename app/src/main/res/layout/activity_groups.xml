<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/brand_background"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ParchApp"
            android:textColor="@color/brand_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/header_search_btn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_light_blue"
            android:contentDescription="@string/cd_search"
            android:padding="9dp"
            android:src="@drawable/ic_search"
            android:tint="@color/brand_dark" />

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp">
            <ImageButton
                android:id="@+id/header_notif_btn"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_light_blue"
                android:contentDescription="@string/cd_notifications"
                android:padding="9dp"
                android:src="@drawable/ic_notifications"
                android:tint="@color/brand_dark" />
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_oval_solid"
                android:backgroundTint="@color/brand_rose" />
        </FrameLayout>

        <TextView
            android:id="@+id/header_user_initials"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_primary_pill"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp">

            <TextView android:id="@+id/groups_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/your_active_groups" android:textColor="@color/brand_dark" android:textSize="20sp" android:textStyle="bold" />

            <TextView android:id="@+id/groups_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:text="@string/no_groups_yet" android:textColor="@color/brand_slate" android:textSize="13sp" android:visibility="gone" />

            <LinearLayout android:id="@+id/groups_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
