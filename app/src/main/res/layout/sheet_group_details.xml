<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_home_indicator" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView
            android:id="@+id/group_modal_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_badge"
            android:gravity="center"
            android:text="🎓"
            android:textSize="18sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/group_modal_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Engineering 2026" android:textColor="@color/brand_dark" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/group_modal_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="28 members • Real-time synced" android:textColor="@color/brand_slate" android:textSize="11sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/sheet_close_btn" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_icon_badge_square" android:backgroundTint="#F1F5F9" android:contentDescription="@string/close" android:padding="8dp" android:src="@drawable/ic_close" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_card_flat" android:orientation="vertical" android:padding="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RECENT SHARED STATUS" android:textColor="@color/brand_slate" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/group_modal_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Linear Algebra midterm study planned for Central Library Room 302 at 4:00 PM." android:textColor="@color/brand_dark" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_ping_availability" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_light_blue" android:text="⚡  Ping Availability" android:textAllCaps="false" android:textColor="@color/brand_dark" android:textSize="12sp" android:textStyle="bold" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_open_chat" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_primary_pill" android:text="@string/open_chat" android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
