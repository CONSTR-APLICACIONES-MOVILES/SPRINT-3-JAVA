<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="3dp"
    android:layout_marginEnd="3dp"
    android:layout_weight="1"
    android:background="@drawable/bg_dashboard_card"
    android:gravity="center"
    android:minHeight="112dp"
    android:orientation="vertical"
    android:padding="8dp">
    <ImageView
        android:id="@+id/profile_stat_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_calendar"
        android:tint="@color/brand_primary" />
    <TextView
        android:id="@+id/profile_stat_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="—"
        android:textColor="@color/brand_primary"
        android:textSize="19sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/profile_stat_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/brand_slate"
        android:textSize="10sp" />
</LinearLayout>
