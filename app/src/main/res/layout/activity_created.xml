<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:gravity="end|center_vertical"
        android:paddingEnd="16dp">
        <ImageButton
            android:id="@+id/close_created_button"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_google_button"
            android:contentDescription="@string/close"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            android:tint="@color/brand_slate" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:id="@+id/activity_loading_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="180dp"
                android:orientation="vertical">
                <ProgressBar
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:indeterminate="true" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="@string/activity_loading_details"
                    android:textColor="@color/brand_slate"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/activity_error_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="180dp"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:id="@+id/activity_error_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/activity_unavailable_title"
                    android:textColor="@color/brand_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/activity_error_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textColor="@color/brand_slate"
                    android:textSize="12sp" />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/retry_activity_button"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_light_blue"
                    android:text="@string/activity_retry"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_primary"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Success content is shown only after the saved activity is loaded. -->
            <LinearLayout
                android:id="@+id/activity_success_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">
                <FrameLayout android:layout_width="88dp" android:layout_height="88dp">
                    <View android:layout_width="88dp" android:layout_height="88dp" android:background="@drawable/bg_oval_solid" android:backgroundTint="@color/brand_success_background" />
                    <TextView android:layout_width="66dp" android:layout_height="66dp" android:layout_gravity="center" android:background="@drawable/bg_oval_solid" android:backgroundTint="@color/brand_success" android:gravity="center" android:text="✓" android:textColor="@android:color/white" android:textSize="30sp" android:textStyle="bold" />
                </FrameLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="@string/activity_created_title" android:textColor="@color/brand_dark" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="@string/activity_created_subtitle" android:textColor="@color/brand_slate" android:textSize="12sp" />
                <TextView android:id="@+id/calendar_added_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_green_chip" android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="10dp" android:paddingBottom="6dp" android:text="Added to calendar" android:textColor="@color/brand_success_dark" android:textSize="10sp" android:textStyle="bold" android:visibility="gone" />
            </LinearLayout>

            <!-- Summary card -->
            <LinearLayout android:id="@+id/activity_summary_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_dashboard_card" android:orientation="vertical" android:padding="14dp" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="-14dp" android:layout_marginStart="-14dp" android:layout_marginEnd="-14dp" android:layout_marginBottom="10dp" android:background="@color/brand_primary" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:id="@+id/created_activity_category" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_light_blue" android:paddingStart="8dp" android:paddingTop="5dp" android:paddingEnd="8dp" android:paddingBottom="5dp" android:textColor="@color/brand_primary" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:id="@+id/created_activity_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:background="@drawable/bg_card_flat" android:paddingStart="8dp" android:paddingTop="5dp" android:paddingEnd="8dp" android:paddingBottom="5dp" android:textColor="@color/brand_dark" android:textSize="10sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/created_activity_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/brand_dark" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/recommendation_outcome_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/brand_primary" android:textSize="11sp" android:visibility="gone" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@color/brand_divider" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="top">
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/bg_icon_badge" android:gravity="center" android:text="◷" android:textColor="@color/brand_primary" android:textSize="12sp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/created_activity_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/brand_dark" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/created_activity_duration" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/brand_slate" android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="top">
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/bg_icon_badge" android:backgroundTint="@color/brand_success_background" android:gravity="center" android:text="⌖" android:textColor="@color/brand_success_dark" android:textSize="12sp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/created_activity_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/brand_dark" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/created_activity_location_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/brand_slate" android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Attendees card -->
            <LinearLayout android:id="@+id/attendees_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_dashboard_card" android:orientation="vertical" android:padding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="INVITED FRIENDS (4)" android:textColor="@color/brand_dark" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 host • 3 pending" android:textColor="@color/brand_slate" android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical">
                    <TextView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/bg_oval_solid" android:backgroundTint="@color/brand_primary" android:gravity="center" android:text="AV" android:textColor="@android:color/white" android:textSize="10sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alex Valenzuela" android:textColor="@color/brand_dark" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Organizer (You)" android:textColor="@color/brand_slate" android:textSize="9sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_green_chip" android:paddingStart="8dp" android:paddingTop="3dp" android:paddingEnd="8dp" android:paddingBottom="3dp" android:text="Ready" android:textColor="@color/brand_success_dark" android:textSize="9sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical">
                    <TextView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/bg_oval_solid" android:backgroundTint="@color/brand_rose" android:gravity="center" android:text="SG" android:textColor="@android:color/white" android:textSize="10sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sofia Gómez" android:textColor="@color/brand_dark" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="sofia.g@unal.edu.co" android:textColor="@color/brand_slate" android:textSize="9sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_neutral" android:paddingStart="8dp" android:paddingTop="3dp" android:paddingEnd="8dp" android:paddingBottom="3dp" android:text="Invited" android:textColor="@color/brand_slate" android:textSize="9sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical">
                    <TextView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/bg_oval_solid" android:backgroundTint="@color/brand_success" android:gravity="center" android:text="MR" android:textColor="@android:color/white" android:textSize="10sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mateo Ríos" android:textColor="@color/brand_dark" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="mateo.r@unal.edu.co" android:textColor="@color/brand_slate" android:textSize="9sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_neutral" android:paddingStart="8dp" android:paddingTop="3dp" android:paddingEnd="8dp" android:paddingBottom="3dp" android:text="Invited" android:textColor="@color/brand_slate" android:textSize="9sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical">
                    <TextView android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/bg_oval_solid" android:backgroundTint="@color/brand_purple" android:gravity="center" android:text="CT" android:textColor="@android:color/white" android:textSize="10sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Camila Torres" android:textColor="@color/brand_dark" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="camila.t@unal.edu.co" android:textColor="@color/brand_slate" android:textSize="9sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_neutral" android:paddingStart="8dp" android:paddingTop="3dp" android:paddingEnd="8dp" android:paddingBottom="3dp" android:text="Invited" android:textColor="@color/brand_slate" android:textSize="9sp" android:textStyle="bold" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@color/brand_divider" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/copy_invite_button"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_light_blue"
                        android:drawableStart="@drawable/ic_link"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/brand_primary"
                        android:text="Copy Invite Link"
                        android:textAllCaps="false"
                        android:textColor="@color/brand_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/whatsapp_button"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_green_chip"
                        android:drawableStart="@drawable/ic_whatsapp"
                        android:drawablePadding="6dp"
                        android:text="WhatsApp"
                        android:textAllCaps="false"
                        android:textColor="@color/brand_success_dark"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Utilities card -->
            <LinearLayout android:id="@+id/activity_utilities_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_dashboard_card" android:orientation="vertical" android:padding="14dp" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_icon_badge" android:gravity="center" android:text="▣" android:textColor="@color/brand_primary" android:textSize="13sp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Google &amp; Apple Calendar" android:textColor="@color/brand_dark" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Auto-sync with external apps" android:textColor="@color/brand_slate" android:textSize="9sp" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/calendar_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:thumbTint="@android:color/white"
                        app:trackTint="@color/brand_primary" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:background="@color/brand_divider" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="⚡  Reminder alert:" android:textColor="@color/brand_slate" android:textSize="11sp" />
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/reminder_button"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_light_blue"
                        android:minWidth="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="15 min before ⌄"
                        android:textAllCaps="false"
                        android:textColor="@color/brand_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/reminder_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/brand_slate" android:textSize="10sp" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/suggested_times_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_light_blue"
            android:text="Suggested Times"
            android:textAllCaps="false"
            android:textColor="@color/brand_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/view_schedule_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_primary_pill"
            android:drawableEnd="@drawable/ic_calendar"
            android:drawablePadding="8dp"
            android:drawableTint="@android:color/white"
            android:text="View in Schedule"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/back_home_button"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_google_button"
            android:text="Back to Home"
            android:textAllCaps="false"
            android:textColor="@color/brand_dark"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
